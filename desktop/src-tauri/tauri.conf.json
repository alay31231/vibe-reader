{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vibe Reader Desktop",
  "version": "0.1.0",
  "identifier": "local.vibe.reader.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/icon.png",
      "icons/icon.icns"
    ],
    "resources": [
      "resources/project-root.txt"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
